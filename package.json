{
  "name": "busyfit-bot",
  "version": "1.0.0",
  "description": "Fitness & Nutrition Coach Telegram bot",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
