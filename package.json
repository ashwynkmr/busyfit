    "node-cron": "^4.6.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
